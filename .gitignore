# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# persisted system config (chứa SMTP password, không commit)
/data/system-config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts / local logs / scan output (không commit)
KZTEK-Work.exe
dev_server_output.txt
tsc_check_output.txt
scripts/english-scan-results.json

# runtime uploads (dữ liệu người dùng, không commit)
/public/uploads/

# .NET build output (mobile app)
[Bb]in/
[Oo]bj/
*.user
.vs/
