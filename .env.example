# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env

# --- Bắt buộc ---
DATABASE_URL="sqlserver://<host>:<port>;database=WorkingManager;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true;"
AUTH_SECRET=""                       # openssl rand -base64 32
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
COOKIE_SECURE="false"                # "true" khi chạy HTTPS

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="KZTEK Work Management"

# --- Zalo OA / ZNS ---
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ID=""
ZALO_OA_SECRET_KEY=""
ZALO_ZNS_TEMPLATE_ID=""

# --- Discord ---
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_WEBHOOK_URL=""

# --- AI ---
OPENAI_API_KEY=""
OPENAI_MODEL=""

# --- Debug Prisma (tuỳ chọn) ---
PRISMA_SLOW_QUERY_MS="150"
PRISMA_LOG_ALL_QUERIES="false"
