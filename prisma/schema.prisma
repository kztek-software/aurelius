generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // true khi mật khẩu do Admin khởi tạo/cấp lại — buộc người dùng đổi mật khẩu ở lần đăng nhập kế tiếp
  mustChangePassword Boolean @default(false)
  avatarColor  String   @default("#6366f1")
  title        String?
  role         String   @default("MEMBER") // ADMIN | MEMBER | VIEWER
  teamId       String?
  phone        String? // Số điện thoại (dùng để gửi Zalo ZNS) - Admin nhập tay
  // Zalo OA follower ID - tự liên kết qua mã xác nhận. @unique an toàn trên PostgreSQL (cho phép nhiều NULL);
  // khi liên kết, lib/zalo/link.ts gỡ liên kết cũ trước để không vi phạm ràng buộc.
  zaloUserId   String?   @unique
  zaloLinkedAt DateTime? // Thời điểm liên kết Zalo OA thành công
  // Discord user ID (snowflake) - liên kết qua OAuth2 "Kết nối Discord" (tự phục vụ) HOẶC Admin nhập tay
  // (giống hai cách liên kết Zalo). @unique như zaloUserId — luồng liên kết gỡ liên kết cũ trước khi gắn.
  discordUserId   String?   @unique
  discordUsername String? // username Discord hiển thị, có được từ OAuth identify — chỉ để hiển thị UI
  discordLinkedAt DateTime?
  createdAt       DateTime @default(now())

  team                   Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ledTeams               Team[]             @relation("TeamLeader")
  ownedProjects          Project[]          @relation("ProjectOwner")
  memberships            ProjectMember[]
  assignedTasks          Task[]             @relation("TaskAssignee")
  createdTasks           Task[]             @relation("TaskCreator")
  comments               Comment[]
  activities             Activity[]
  attachments            Attachment[]
  receivedNotifications  Notification[]     @relation("UserNotifications")
  triggeredNotifications Notification[]     @relation("ActorNotifications")
  zaloMessageLogs        ZaloMessageLog[]
  zaloLinkCodes          ZaloLinkCode[]
  discordMessageLogs     DiscordMessageLog[]
  notificationPreference UserNotificationPreference?
}

// Tùy chọn kênh nhận thông báo CỦA RIÊNG TỪNG USER — lớp lọc thứ 2 sau công tắc tổng ở SystemSetting.
// 1 dòng / user, không tồn tại nghĩa là user chưa tùy chỉnh -> áp dụng mặc định "nhận tất cả" (true).
// Quy tắc cuối cùng khi quyết định gửi: SystemSetting.notifyOnX (công tắc tổng) AND UserNotificationPreference.xOnY (tùy chọn cá nhân).
model UserNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  emailOnAssign       Boolean @default(true)
  emailOnStatusChange Boolean @default(true)
  emailOnComment      Boolean @default(true)
  emailOnMention      Boolean @default(true)

  zaloOnAssign       Boolean @default(true)
  zaloOnStatusChange Boolean @default(true)
  zaloOnComment      Boolean @default(true)
  zaloOnMention      Boolean @default(true)

  inAppOnAssign       Boolean @default(true)
  inAppOnStatusChange Boolean @default(true)
  inAppOnComment      Boolean @default(true)
  inAppOnMention      Boolean @default(true)

  // DM Discord cá nhân (kênh webhook broadcast vào channel chung KHÔNG có tùy chọn theo user — mọi
  // người trong server Discord đều thấy chung, không phải kênh riêng tư nên không cần lọc theo cá nhân)
  discordOnAssign       Boolean @default(true)
  discordOnStatusChange Boolean @default(true)
  discordOnComment      Boolean @default(true)
  discordOnMention      Boolean @default(true)

  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  color       String   @default("#F05922")
  leaderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader      User?    @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     User[]   @relation("TeamMembers")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  color       String   @default("#6366f1")
  isSystem    Boolean  @default(false)
  permissions String   @db.Text // JSON Array string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String   // ASSIGNED | STATUS_CHANGED | COMMENTED | DUE_SOON
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  link      String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?  @db.Text
  status      String   @default("PLANNING") // PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members         ProjectMember[]
  sprints         Sprint[]
  tasks           Task[]
  labels          Label[]
  customerTickets CustomerTicket[]
  attachments     Attachment[]
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, userId])
}

model Sprint {
  id        String    @id @default(cuid())
  projectId String
  name      String
  goal      String?   @db.Text
  status    String    @default("PLANNING") // PLANNING | ACTIVE | COMPLETED
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks   Task[]
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  sprintId    String?
  number      Int
  title       String
  description String?   @db.Text
  type        String    @default("TASK") // TASK | BUG | STORY | EPIC
  status      String    @default("TODO") // BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  storyPoints Int?
  position    Float     @default(0)
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sprint         Sprint?         @relation(fields: [sprintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator        User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels         TaskLabel[]
  comments       Comment[]
  activity       Activity[]
  subtasks       Subtask[]
  attachments    Attachment[]
  customerTicket CustomerTicket? @relation("TaskCustomerTicket")

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([projectId, dueDate])
  @@index([assigneeId])
  @@index([createdAt])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String @default("#6366f1")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks   TaskLabel[]

  @@unique([projectId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  label Label @relation(fields: [labelId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([taskId, labelId])
}

model Subtask {
  id     String  @id @default(cuid())
  taskId String
  title  String
  done   Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author User @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String // CREATED | STATUS_CHANGED | ASSIGNED | UPDATED | COMMENTED
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([createdAt])
}

model CustomerTicket {
  id              String   @id @default(cuid())
  trackingCode    String   @unique
  projectId       String?
  title           String
  description     String   @db.Text
  type            String   @default("BUG") // BUG | SUPPORT | INQUIRY | FEATURE_REQ
  status          String   @default("OPEN") // OPEN | TRIAGED | IN_PROGRESS | RESOLVED | CLOSED | REJECTED
  priority        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  customerName    String
  customerEmail   String
  customerPhone   String?
  customerCompany String?
  environment     String?  @db.Text // Browser, OS, Device, Version
  convertedTaskId String?  @unique
  internalNotes   String?  @db.Text
  resolutionNotes String?  @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Project?         @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedTask Task?            @relation("TaskCustomerTicket", fields: [convertedTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments      TicketComment[]
  attachments   Attachment[]

  @@index([status])
  @@index([projectId])
  @@index([createdAt])
}

model TicketComment {
  id             String   @id @default(cuid())
  ticketId       String
  authorName     String
  authorEmail    String?
  isStaff        Boolean  @default(false)
  isInternalOnly Boolean  @default(false)
  message        String   @db.Text
  createdAt      DateTime @default(now())

  ticket CustomerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticketId])
  @@index([createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  projectId  String?
  taskId     String?
  ticketId   String?
  uploaderId String?
  fileName   String
  fileUrl    String   @db.Text
  fileType   String   // image | video | document | other
  fileSize   Int?     // bytes
  mimeType   String?
  createdAt  DateTime @default(now())

  project  Project?        @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task     Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket   CustomerTicket? @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploader User?           @relation(fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@index([taskId])
  @@index([ticketId])
}

model SystemSetting {
  id                   String   @id @default("default")
  // SMTP Settings
  smtpHost             String?  @default("")
  smtpPort             Int      @default(587)
  smtpUser             String?  @default("")
  smtpPass             String?  @default("")
  smtpSecure           Boolean  @default(false)
  smtpFrom             String   @default("no-reply@kztek.net")
  smtpFromName         String   @default("KZTEK Work Management")

  // Branding Settings
  systemName           String   @default("KZTEK Work Management")
  companyName          String   @default("CÔNG TY CỔ PHẦN CÔNG NGHỆ KZTEK")
  hotline              String   @default("024 3782 2288")
  supportEmail         String   @default("support@kztek.net")
  website              String   @default("https://kztek.net")
  appUrl               String   @default("http://localhost:3000")

  // Notification Rules
  notifyOnAssign       Boolean  @default(true)
  notifyOnStatusChange Boolean  @default(true)
  notifyOnComment      Boolean  @default(true)
  enableRealtimeSse    Boolean  @default(true)

  // Zalo Integration Settings (Official Account + ZNS)
  enableZaloIntegration    Boolean   @default(false)
  zaloAppId                String?   @default("")
  zaloAppSecret            String?   @default("")
  zaloOaId                 String?   @default("")
  zaloOaSecretKey          String?   @default("") // OA Secret Key dùng để verify webhook signature
  zaloAccessToken          String?   @default("")
  zaloRefreshToken         String?   @default("")
  zaloTokenExpiresAt       DateTime?
  zaloZnsTemplateId        String?   @default("")
  notifyZaloOnAssign       Boolean   @default(false)
  notifyZaloOnStatusChange Boolean   @default(false)
  notifyZaloOnComment      Boolean   @default(false)

  // Discord Integration Settings (Bot DM cá nhân + Webhook kênh chung)
  enableDiscordIntegration    Boolean @default(false)
  discordClientId             String? @default("") // OAuth2 Application (Client) ID - dùng cho "Kết nối Discord"
  discordClientSecret         String? @default("")
  discordBotToken             String? @default("") // Bot Token - dùng để gửi DM cá nhân qua REST API
  discordWebhookUrl           String? @default("") // Discord Incoming Webhook URL - đăng tin vào 1 kênh chung
  // Quy tắc gửi DM cá nhân (chỉ user đã tự liên kết Discord mới nhận)
  notifyDiscordOnAssign       Boolean @default(false)
  notifyDiscordOnStatusChange Boolean @default(false)
  notifyDiscordOnComment      Boolean @default(false)
  // Quy tắc đăng vào kênh chung qua Webhook (độc lập với DM cá nhân, không phụ thuộc từng user)
  discordWebhookOnAssign       Boolean @default(false)
  discordWebhookOnStatusChange Boolean @default(false)
  discordWebhookOnComment      Boolean @default(false)

  updatedAt            DateTime @default(now()) @updatedAt
  updatedBy            String?  @default("Hệ thống (Mặc định)")
}

model DiscordMessageLog {
  id               String    @id @default(cuid())
  userId           String? // null nếu là tin đăng Webhook kênh chung (không gắn 1 user cụ thể)
  discordUserId    String? // người nhận DM
  channel          String // DM | WEBHOOK
  notificationType String? // ASSIGNED | STATUS_CHANGED | COMMENTED | MENTIONED | TEST
  content          String    @db.Text
  status           String    @default("PENDING") // PENDING | SENT | FAILED
  providerMsgId    String?
  errorMessage     String?   @db.Text
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model ZaloMessageLog {
  id               String    @id @default(cuid())
  userId           String?
  zaloUserId       String? // Zalo OA follower ID nhận tin (kênh OA)
  phone            String? // Số điện thoại nhận tin (kênh ZNS)
  channel          String // ZNS | OA
  notificationType String? // ASSIGNED | STATUS_CHANGED | COMMENTED | MENTIONED | TEST
  templateId       String?
  content          String    @db.Text
  status           String    @default("PENDING") // PENDING | SENT | FAILED
  providerMsgId    String?
  errorMessage     String?   @db.Text
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model ZaloLinkCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

